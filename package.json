{
  "name": "news-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint ./src --ext .jsx,.ts,.tsx",
    "lint:fix": "eslint ./src --ext .jsx,.ts,.tsx --fix",
    "prettier": " prettier \"./**/*.{ts,tsx}\"",
    "prettier:write": " prettier --write \"./**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "generate:api": "dotenv -e .env -- orval",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.89.0",
    "axios": "^1.12.2",
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "orval": "^7.11.2",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0"
  }
}
